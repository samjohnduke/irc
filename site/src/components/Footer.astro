---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-border-dim">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <!-- Left: branding -->
      <div>
        <div class="flex items-center gap-2.5">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-500/10 border border-cyan-500/20">
            <span class="font-mono text-xs font-bold text-cyan-400">&gt;_</span>
          </div>
          <span class="font-display text-xl text-white tracking-tight">irc</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-gray-600">
          A modern IRC server and client suite, built in Rust for speed and reliability.
        </p>
      </div>

      <!-- Right: links -->
      <div class="flex gap-16">
        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-gray-600">Project</h4>
          <ul class="mt-3 space-y-2">
            <li><a href="/guide/" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">Guide</a></li>
            <li><a href="/guide/installation/" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">Installation</a></li>
            <li><a href="/guide/configuration/" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">Configuration</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-gray-600">Community</h4>
          <ul class="mt-3 space-y-2">
            <li><a href="https://github.com/samjohnduke/irc" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">GitHub</a></li>
            <li><a href="https://github.com/samjohnduke/irc/releases" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">Releases</a></li>
            <li><a href="https://github.com/samjohnduke/irc/issues" class="text-sm text-gray-500 transition-colors hover:text-cyan-400">Issues</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex items-center justify-between border-t border-border-dim pt-6">
      <p class="font-mono text-[11px] text-gray-700">
        &copy; {year} irc project
      </p>
      <p class="font-mono text-[11px] text-gray-700">
        MIT / Apache-2.0
      </p>
    </div>
  </div>
</footer>
