---
import type { NavSection } from "../data/navigation";

interface Props {
  sections: NavSection[];
  basePath: string;
  label: string;
}

const { sections, basePath, label } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class="space-y-8">
  <a href={`${basePath}/`} class="group flex items-center gap-2.5">
    <div class="flex h-6 w-6 items-center justify-center rounded-md bg-cyan-500/10 border border-cyan-500/20 transition-colors group-hover:bg-cyan-500/20">
      <svg class="h-3 w-3 text-cyan-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M2 3h8M2 6h5M2 9h7" />
      </svg>
    </div>
    <span class="font-mono text-xs font-medium text-gray-400 transition-colors group-hover:text-white">{label}</span>
  </a>

  {sections.map((section) => (
    <div>
      <h4 class="mb-3 font-mono text-[11px] uppercase tracking-[0.15em] text-gray-600">
        {section.title}
      </h4>
      <ul class="space-y-0.5">
        {section.items.map(({ label, slug }) => {
          const href = `${basePath}/${slug}/`;
          const active = currentPath === href;
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "group relative flex items-center rounded-lg px-3 py-2 text-sm transition-all duration-200",
                  active
                    ? "bg-cyan-500/[0.07] text-cyan-400"
                    : "text-gray-500 hover:bg-white/[0.03] hover:text-gray-300",
                ]}
              >
                {/* Active indicator */}
                {active && (
                  <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-cyan-400"></span>
                )}
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
