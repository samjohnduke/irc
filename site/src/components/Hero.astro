---
import Terminal from "./Terminal.astro";
---

<section class="relative min-h-screen overflow-hidden pt-32 pb-24 grid-bg noise">
  <!-- Radial glow -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-1/4 h-[800px] w-[1000px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-500/[0.07] blur-[120px] animate-glow-pulse"></div>
    <div class="absolute right-0 bottom-0 h-[400px] w-[400px] rounded-full bg-cyan-700/[0.04] blur-[100px]"></div>
  </div>

  <!-- Decorative grid crosshair -->
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
    <div class="h-px w-[600px] bg-gradient-to-r from-transparent via-cyan-500/10 to-transparent"></div>
    <div class="h-[600px] w-px bg-gradient-to-b from-transparent via-cyan-500/10 to-transparent absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Badge -->
    <div class="flex justify-center animate-fade-up" style="animation-delay: 0ms;">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised/80 px-4 py-1.5 backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
        </span>
        <span class="font-mono text-xs text-gray-400">v0.1.0 — now available</span>
      </div>
    </div>

    <!-- Headline -->
    <div class="mx-auto mt-10 max-w-4xl text-center animate-fade-up" style="animation-delay: 100ms;">
      <h1 class="font-display text-6xl tracking-tight text-white sm:text-8xl lg:text-9xl">
        IRC, forged
        <br />
        <span class="relative inline-block">
          in
          <em class="not-italic bg-gradient-to-r from-cyan-300 via-cyan-400 to-cyan-200 bg-clip-text text-transparent">Rust</em>
          <!-- Underline decoration -->
          <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 300 12" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path d="M2 8C50 3 100 4 150 6C200 8 250 5 298 3" stroke="url(#grad)" stroke-width="2" stroke-linecap="round" />
            <defs>
              <linearGradient id="grad" x1="0" y1="0" x2="300" y2="0" gradientUnits="userSpaceOnUse">
                <stop stop-color="#22d3ee" stop-opacity="0" />
                <stop offset="0.3" stop-color="#22d3ee" stop-opacity="0.5" />
                <stop offset="0.7" stop-color="#22d3ee" stop-opacity="0.5" />
                <stop offset="1" stop-color="#22d3ee" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>
        </span>
      </h1>
    </div>

    <!-- Subhead -->
    <p class="mx-auto mt-8 max-w-xl text-center text-lg leading-relaxed text-gray-400 animate-fade-up" style="animation-delay: 200ms;">
      A modern server and client suite. Fast, secure, and simple to deploy.
      Full RFC 2812 compliance with TLS out of the box.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center animate-fade-up" style="animation-delay: 300ms;">
      <a
        href="/guide/getting-started/"
        class="group inline-flex items-center gap-2 rounded-full bg-cyan-500 px-7 py-3 text-sm font-semibold text-gray-950 transition-all duration-300 hover:bg-cyan-400 hover:shadow-[0_0_30px_rgba(34,211,238,0.4)]"
      >
        Get Started
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="2">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
      <a
        href="https://github.com/example/irc"
        class="inline-flex items-center gap-2 rounded-full border border-border px-7 py-3 text-sm font-medium text-gray-300 transition-all duration-300 hover:border-gray-600 hover:text-white hover:bg-white/5"
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        View Source
      </a>
    </div>

    <!-- Terminal -->
    <div class="mx-auto mt-16 max-w-2xl animate-fade-up" style="animation-delay: 450ms;">
      <Terminal title="bash — 80×24">
        <div class="space-y-1">
          <p><span class="text-cyan-600">~</span> <span class="text-gray-500">$</span> <span class="text-cyan-300">curl -sSf</span> <span class="text-gray-400">https://irc.example.com/install.sh</span> <span class="text-cyan-300">| sh</span></p>
          <p class="text-gray-600 text-[12px]">&nbsp;</p>
          <p class="text-emerald-400">  ✓ <span class="text-gray-300">irc-server</span> <span class="text-gray-600">v0.1.0</span> <span class="text-gray-600">(linux-x86_64)</span></p>
          <p class="text-emerald-400">  ✓ <span class="text-gray-300">irc</span> <span class="text-gray-600">v0.1.0</span> <span class="text-gray-600">(linux-x86_64)</span></p>
          <p class="text-emerald-400">  ✓ <span class="text-gray-300">irc-gui</span> <span class="text-gray-600">v0.1.0</span> <span class="text-gray-600">(linux-x86_64)</span></p>
          <p class="text-gray-600 text-[12px]">&nbsp;</p>
          <p class="text-gray-500">  Installed to /usr/local/bin</p>
          <p class="text-gray-600 text-[12px]">&nbsp;</p>
          <p><span class="text-cyan-600">~</span> <span class="text-gray-500">$</span> <span class="text-gray-300">irc-server</span> <span class="text-cyan-300">--config</span> <span class="text-amber-300">server.toml</span></p>
          <p class="text-cyan-400">  irc-server listening on <span class="text-white font-bold">0.0.0.0:6697</span> <span class="text-cyan-600">(TLS)</span></p>
          <p><span class="text-cyan-600">│</span><span class="inline-block w-2 h-4 bg-cyan-400/80 animate-blink ml-0.5 align-middle"></span></p>
        </div>
      </Terminal>
    </div>
  </div>
</section>
